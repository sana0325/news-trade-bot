<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Легкий міст-тема до першого кадру Compose: сама тема (dark, зелений/червоний
      для PnL) визначена в Kotlin (ui/theme/Theme.kt) через Material3 ColorScheme.
    -->
    <style name="Theme.ScalpBot" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/scalpbot_background</item>
        <item name="android:statusBarColor">@color/scalpbot_background</item>
        <item name="android:navigationBarColor">@color/scalpbot_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:colorAccent">@color/scalpbot_primary</item>
    </style>
</resources>
