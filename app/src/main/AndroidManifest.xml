<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Мережа -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Фоновий торговий двигун -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Сповіщення (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShiScalpBotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ShiScalpBot"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShiScalpBot"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          specialUse: торговий двигун мусить працювати без часових обмежень, які
          Android 15 (API 35) накладає на тип dataSync (сукупний ліміт ~6 год/добу).
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE обов'язковий з Android 14 (API 34) і
          пояснює системі/Play Console призначення сервісу.
        -->
        <service
            android:name=".service.TradingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Автономний скальпінг-бот: безперервне виконання угод на біржі за сигналами реального часу, поки користувач тримає бота увімкненим." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Зміни мережі (Wi-Fi <-> мобільна) відстежуються через
          ConnectivityManager.NetworkCallback, зареєстрований у сервісі
          в рантаймі (Android 7+ не доставляє CONNECTIVITY_ACTION статичним ресіверам).
        -->

    </application>

</manifest>
